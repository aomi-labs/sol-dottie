# Aomi backend. Leave empty for production (https://chat.aomi.dev).
VITE_AOMI_API_URL=
# The hosted Sol Dottie App's Application ID. Leave empty to show the
# sample-data concept desk instead of the live chat.
VITE_DOTTIE_APPLICATION_ID=
# Optional: the Dottie Telegram bot, e.g. https://t.me/<bot_username>.
VITE_DOTTIE_TELEGRAM_URL=

# Public browser credentials for the same provider projects as the target portal.
# Never put Para's server secret or a Privy app secret in VITE_* variables.
VITE_PRIVY_APP_ID=
VITE_PARA_API_KEY=
VITE_PARA_ENVIRONMENT=BETA
