// Dottie's settings Worker: worker/index.js, one KV document per Aomi
// account. Nothing here is deployed automatically.
//
// Local:  npx wrangler dev -c worker/wrangler.jsonc --var SETTINGS_TOKEN:local-dev-token
//         then set DOTTIE_SETTINGS_URL=http://127.0.0.1:8787 and
//         DOTTIE_SETTINGS_TOKEN=local-dev-token as the app's secrets.
// Deploy: create the namespace once (npx wrangler kv namespace create dottie-settings),
//         put its id below, then npx wrangler secret put SETTINGS_TOKEN -c worker/wrangler.jsonc
//         and npx wrangler deploy -c worker/wrangler.jsonc.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dottie-settings",
  "compatibility_date": "2026-10-13",
  "main": "index.js",
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "SETTINGS", "id": "00000000000000000000000000000000" }
  ]
}
